# TelcoPulse CRM — Production Environment Configuration
# Copy this file to .env before deploying

# Host binding (use 0.0.0.0 for Docker/Cloud deployments like Render, Railway, Fly.io, AWS)
HOST=0.0.0.0
PORT=8000

# API Documentation (Set to "false" in production to prevent schema reconnaissance)
ENABLE_DOCS=false

# Allowed CORS Origins (comma-separated list of trusted domains)
# Example: ALLOWED_ORIGINS=https://your-domain.com,https://dashboard.your-domain.com
ALLOWED_ORIGINS=

# Lightweight Authentication (Optional for local dev, recommended for production)
# Set REQUIRE_AUTH=true to mandate Bearer token / API key on prediction and data endpoints
REQUIRE_AUTH=false
AUTH_TOKEN=
API_KEY=

# In-Memory Rate Limiting Configuration (Per client IP)
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BATCH=10
RATE_LIMIT_PREDICT=60
RATE_LIMIT_EMAIL=30
RATE_LIMIT_CUSTOMERS=60
RATE_LIMIT_GENERAL=120

# Reverse Proxy & Transport Security
# Set TRUST_PROXY_HEADERS=true when running behind an authentic reverse proxy (NGINX, Cloudflare, AWS ALB)
TRUST_PROXY_HEADERS=true
# Set ENABLE_HSTS=true to enforce Strict-Transport-Security on HTTPS deployments
ENABLE_HSTS=false
